# Telegram API Credentials (from https://my.telegram.org)
TG_API_ID=
TG_API_HASH=

# Spotify Developer Credentials (optional fallback from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Default bio when Spotify is paused or stopped (max 70 characters)
DEFAULT_BIO=Listening to Spotify • vibes
